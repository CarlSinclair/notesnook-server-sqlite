# /opt/notesnook/.env  —  plain KEY=value only (no quotes, no inline # comments).
# Read by every service via DotNetEnv AND sourced by run.sh for health-check ports.
# chmod 600, owner notesnook:notesnook.

# ---- identity / instance -------------------------------------------------------
SELF_HOSTED=1
INSTANCE_NAME=notesnook
# 64 hex chars. Shared secret: Identity's API secret == API's introspection secret.
# generate: openssl rand -hex 32
NOTESNOOK_API_SECRET=REPLACE_WITH_openssl_rand_hex_32
# false to register the one account, then flip to true and restart.
DISABLE_SIGNUPS=false

# ---- SQLite (one file, all three EF contexts) --------------------------------
# Absolute path so Identity and API open the same file regardless of CWD.
DB_PATH=/opt/notesnook/data/notesnook.db

# ---- internal bind: host + port per service (the reverse proxy targets these) -
# These are Notesnook's standard ports; change them here and in the proxy config
# together if they clash with something else on the box.
IDENTITY_SERVER_HOST=127.0.0.1
IDENTITY_SERVER_PORT=8264
NOTESNOOK_SERVER_HOST=127.0.0.1
NOTESNOOK_SERVER_PORT=5264
SSE_SERVER_HOST=127.0.0.1
SSE_SERVER_PORT=7264

# ---- public URLs (used for email links / redirects only) --------------------
IDENTITY_SERVER_URL=https://auth.notesnook.example.com
NOTESNOOK_APP_HOST=https://notesnook.example.com
MONOGRAPH_PUBLIC_URL=https://notesnook.example.com
# The proxy terminates TLS and sets X-Forwarded-*; tell the apps to trust it.
KNOWN_PROXIES=127.0.0.1

# ---- attachments: any S3-compatible endpoint (path-style), e.g. Cloudflare R2 -
S3_SERVICE_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=notesnook
S3_ACCESS_KEY_ID=<S3_ACCESS_KEY_ID>
S3_ACCESS_KEY=<S3_SECRET_ACCESS_KEY>

# ---- SMTP (optional; only password-reset + email-2FA need it) ---------------
# Self-hosted signup auto-confirms the email, so this is not required to start.
# Authenticator-app 2FA works with no SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTESNOOK_SENDER_EMAIL=no-reply@example.com
SMTP_REPLYTO_EMAIL=no-reply@example.com

# ---- optional feature levers ----------------------------------------------
# Monograph publishing is in-process. Public monograph pages render in the API.
ENABLE_MONOGRAPHS=true
ENABLE_INBOX=true

# ---- unused on a single instance -----------------------------------------
# SIGNALR_REDIS_CONNECTION_STRING=
